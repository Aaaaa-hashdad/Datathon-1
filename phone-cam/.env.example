# Copy to .env (same folder) and fill in. .env is in .gitignore: never commit it.
# Leave the Supabase values empty to keep motion logs on this PC only.

# Supabase -> Project Settings -> Data API -> Project URL (https://abcd1234.supabase.co)
SUPABASE_URL=
# Supabase -> Project Settings -> API Keys -> a secret key (sb_secret_...) or the legacy service_role key.
# Server only: it bypasses Supabase security. Never put it in a web page, chat or git.
SUPABASE_SERVICE_ROLE_KEY=
# Private Storage bucket for the Excel files (created automatically if missing).
SUPABASE_BUCKET=motion-logs

# Who is training (folder name). Can also be changed with POST /motionlog/user.
MOTION_USER=guest
# Minutes with nobody in view before a new session file starts.
SESSION_GAP_MIN=15
