# Copy this file to .env and fill it in. Never commit .env: it holds secrets.
# Leave everything blank to run fully local (SQLite + backend/uploads).

# Supabase -> Project Settings -> Database -> Connection string -> "Session pooler" (URI).
# Replace [YOUR-PASSWORD] with your database password.
DATABASE_URL=

# Supabase -> Project Settings -> Data API -> Project URL  (looks like https://abcd1234.supabase.co)
SUPABASE_URL=
# Supabase -> Project Settings -> API Keys -> a Secret key (sb_secret_...) or the legacy service_role key.
# Server only: it bypasses all security. Never put it in the website, the phone page, chat, or git.
SUPABASE_SERVICE_ROLE_KEY=
# Private Storage bucket for videos (created automatically if missing).
SUPABASE_BUCKET=recordings

# Optional: keeps video links valid across restarts. Any long random string.
SECRET_KEY=
